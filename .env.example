# ============================================
# NEXUS Environment Variables
# ============================================

# ---- Database ----
DATABASE_URL="postgresql://postgres:password@localhost:5432/nexus"

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Authentication ----
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="30d"
SESSION_MAX_AGE_DAYS=30
MAX_SESSIONS=5

# ---- Cloud Storage (S3-compatible) ----
# Works with AWS S3, DigitalOcean Spaces, Backblaze B2, etc.
STORAGE_ENDPOINT="https://your-region.s3.amazonaws.com"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_BUCKET="nexus-storage"
STORAGE_REGION="us-east-1"
STORAGE_PUBLIC_URL=""

# ---- Push Notifications (Expo) ----
EXPO_PROJECT_ID="your-expo-project-id"
EXPO_ACCESS_TOKEN="your-expo-access-token"

# ---- Rate Limiting ----
LOGIN_RATE_LIMIT=5
INVITATION_RATE_LIMIT=10
GENERAL_RATE_LIMIT=100

# ---- Invitation ----
INVITATION_EXPIRATION_HOURS=48

# ---- Upload ----
MAX_UPLOAD_SIZE=10485760
MAX_AUDIO_UPLOAD_SIZE=20971520

# ---- WebRTC (Voice & Video Calls) ----
# STUN servers for NAT traversal (comma-separated)
STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
# Optional TURN server for restrictive networks
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# ---- CORS ----
CORS_ORIGIN="http://localhost:8081"
