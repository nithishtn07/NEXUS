# ============================================
# NEXUS Server Environment Variables
# ============================================
# Copy this to .env and fill in the values.
# For Render: set these in the Render Dashboard → Environment tab.

# ---- Database (Supabase PostgreSQL) ----
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---- Server ----
PORT=3000
NODE_ENV=production

# ---- Authentication ----
JWT_SECRET="generate-a-random-64-char-string"
JWT_EXPIRES_IN="30d"
SESSION_MAX_AGE_DAYS=30
MAX_SESSIONS=5

# ---- Cloud Storage (S3-compatible) ----
STORAGE_ENDPOINT="https://your-region.s3.amazonaws.com"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_BUCKET="nexus-storage"
STORAGE_REGION="us-east-1"
STORAGE_PUBLIC_URL=""

# ---- Push Notifications (Expo) ----
EXPO_PROJECT_ID="your-expo-project-id"
EXPO_ACCESS_TOKEN="your-expo-access-token"

# ---- Rate Limiting ----
LOGIN_RATE_LIMIT=5
INVITATION_RATE_LIMIT=10
GENERAL_RATE_LIMIT=100

# ---- Invitation ----
INVITATION_EXPIRATION_HOURS=48

# ---- Upload ----
MAX_UPLOAD_SIZE=10485760
MAX_AUDIO_UPLOAD_SIZE=20971520

# ---- WebRTC ----
STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# ---- CORS (comma-separated origins) ----
CORS_ORIGIN="https://your-app-name.onrender.com,nexus://"
